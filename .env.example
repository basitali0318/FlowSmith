# --- LLM (open-source models) -------------------------------------------------
# Groq serves open-source Llama/Qwen models over an OpenAI-compatible API (recommended for the hosted demo).
LLM_PROVIDER=groq
GROQ_API_KEY=            # create one at https://console.groq.com/keys - never commit it
# LLM_MODEL=openai/gpt-oss-120b   # optional pin; by default the best open model the key can use is auto-selected

# Self-hosted alternatives
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_PROVIDER=openai          # vLLM or any OpenAI-compatible server
# LLM_BASE_URL=http://localhost:8000
# LLM_PROVIDER=none            # force the offline rules engine

# --- Backend --------------------------------------------------------------------
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# DATABASE_URL=postgres://flowsmith:flowsmith@localhost:5432/flowsmith   # omit to use in-memory storage
# DEMO_EMAIL=demo@flowsmith.ai
# DEMO_PASSWORD=Demo@1234
# SHOW_DEMO_CREDENTIALS=false   # hide the "Use demo account" button
# RATE_LIMIT=120                # requests / minute / IP
# GENERATE_RATE_LIMIT=12        # diagram generations / minute / IP
